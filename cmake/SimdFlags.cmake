# SIMD_WIDTH maps to machine flags the same way Stim's CMakeLists.txt does.
# 256 = AVX2 (every Perlmutter CPU has it).  128 = SSE2, the width of Stim's PyPI wheels.
set(SIMD_WIDTH 256 CACHE STRING "SIMD word width: 64, 128 or 256 (empty = -march=native)")
if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|I386)$")
  if(NOT SIMD_WIDTH)
    set(MACHINE_FLAG -march=native)
  elseif(SIMD_WIDTH EQUAL 256)
    set(MACHINE_FLAG -mavx2 -msse2)
  elseif(SIMD_WIDTH EQUAL 128)
    set(MACHINE_FLAG -mno-avx2 -msse2)
  elseif(SIMD_WIDTH EQUAL 64)
    set(MACHINE_FLAG -mno-avx2 -mno-sse2)
  else()
    message(FATAL_ERROR "SIMD_WIDTH must be 64, 128, 256 or empty, not '${SIMD_WIDTH}'")
  endif()
else()
  set(MACHINE_FLAG "")
endif()
